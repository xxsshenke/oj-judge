<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yzj.mapper.UserMapper">

    <select id="findById" resultType="com.yzj.pojo.User">
        select id,
               username,
               nickname,
               email,
               avatar,
               bio,
               school,
               rating,
               solved_count,
               submit_count,
               role,
               status,
               create_time,
               update_time
        from `user`
        where id = #{id}
    </select>

</mapper>
