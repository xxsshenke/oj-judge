# ==================== 构建产物 ====================
# Maven 编译输出，可随时 mvn compile 重新生成
target/
*.class

# ==================== IDE / 工具本地配置 ====================
# 含机器专属绝对路径，且每人配置不同，不进仓库
.idea/
*.iml
.vscode/

# WorkBuddy 等本地助手的记忆文件（个人笔记，不属于项目代码）
.workbuddy/

# ==================== 文档 ====================
# 设计稿、验证报告、实现详解均为本地工作笔记，不随代码提交。
# 需要写文档时仍写在 docs/ 下，只是不被 git 跟踪。
docs/

# ==================== 前端 ====================
# Vite 依赖与本地缓存
**/node_modules/
**/dist/
*.local
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==================== 密钥 / 本地配置 ====================
# 防止误提交 API Key、数据库口令等
.env
.env.*
!.env.example
*.pem
*.key

# ==================== 操作系统杂项 ====================
Thumbs.db
.DS_Store
Desktop.ini
